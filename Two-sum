//Two sum problem using two pointer method
import java.util.*;
public class Main {
    public static void main(String[] args) {
        int arr[] = {2,7,11,15};
        int target = 9;
        System.out.println(Check(arr, target));
        
    }
    public static boolean Check(int arr[],int target){
        int n = arr.length;
        int left = 0;
        int right = n-1;
        while(left<right){
            if(arr[left]+arr[right] == target){
                return true;
            }
            else if(arr[left]+arr[right]>target){
                right--;
            }
            else{
                left++;
            }
        }
        return false;
    }
}
